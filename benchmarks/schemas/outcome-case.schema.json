{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manny536/excellence-engine-v4/benchmarks/schemas/outcome-case.schema.json",
  "title": "OutcomeCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "title",
    "controlling_designation",
    "governing_rule",
    "findings",
    "open_seals",
    "artifact_ids",
    "public_url",
    "held_trace"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "controlling_designation": {"type": "string", "minLength": 1},
    "governing_rule": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "open_seals": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "public_url": {"type": "string", "format": "uri"},
    "held_trace": {"type": "object"}
  }
}
