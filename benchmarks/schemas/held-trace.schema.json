{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manny536/excellence-engine-v4/benchmarks/schemas/held-trace.schema.json",
  "title": "HELDTrace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "designation",
    "object",
    "state",
    "status_tags",
    "h_eval",
    "evidence",
    "correction",
    "falsifier",
    "source_refs"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "designation": {"type": "string", "minLength": 1},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "formulation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "formulation": {"type": "string", "minLength": 1}
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "HELD-ACTIVE",
        "HELD-REVISED",
        "HELD-RETAINED",
        "HELD-RELEASED",
        "HELD-CLOSED"
      ]
    },
    "status_tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "h_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bound", "passed"],
      "properties": {
        "bound": {"const": "< 1"},
        "passed": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supporting", "counter"],
      "properties": {
        "supporting": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceItem"}
        },
        "counter": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceItem"}
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "before", "after", "closed_lane", "continuity_preserved"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "closed_lane": {"type": "string", "minLength": 1},
        "continuity_preserved": {"const": true}
      }
    },
    "falsifier": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {"basis": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    }
  }
}
