{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peaice.org/schemas/eev4-paper-reference-register-v1.json",
  "title": "EEV4 paper reference register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "snapshot_policy",
    "references"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_policy": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authors",
        "title",
        "year",
        "venue",
        "identifiers",
        "primary_url",
        "source_snapshot",
        "eev4_role",
        "reference_status",
        "use",
        "claim_boundary",
        "bridge_effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]+-[a-z0-9-]+$"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "identifiers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provided_name",
            "pages",
            "sha256"
          ],
          "properties": {
            "provided_name": {
              "type": "string",
              "minLength": 1
            },
            "pages": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "eev4_role": {
          "enum": [
            "dependency-tower",
            "comparative-operator-example",
            "kakeya-theorem-background",
            "inertial-dynamics-background",
            "spectral-operator-background",
            "spectral-determinant-background"
          ]
        },
        "reference_status": {
          "enum": [
            "KNOWN",
            "THEOREM-BACKGROUND",
            "STRUCTURAL-ANALOGY"
          ]
        },
        "use": {
          "type": "string",
          "minLength": 1
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        },
        "bridge_effect": {
          "const": "does-not-close"
        }
      }
    }
  }
}
